//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        // tap: the keycode in the binding's second cell, hold: Option
        alfred_opt: alfred_opt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
            display-name = "Alfred/Option";
        };

        // App switcher on SYM (zmk-tri-state module): T steps forward (right, Tab),
        // R steps back (left, Shift+Tab). Either one opens the switcher and holds Cmd;
        // pressing the other keeps it open; releasing SYM (or any other key) releases
        // Cmd. Cmd is held with press/release macros, not &kt, so the two swappers can
        // run together: ZMK counts explicit modifier presses and releases Cmd only when
        // both have let go.
        swap_fwd: swap_fwd {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&cmd_hold>, <&kp TAB>, <&cmd_release>;
            ignored-key-positions = <3>;
        };

        swap_back: swap_back {
            compatible = "zmk,behavior-tri-state";
            #binding-cells = <0>;
            bindings = <&cmd_hold>, <&kp LS(TAB)>, <&cmd_release>;
            ignored-key-positions = <4>;
        };
    };

    macros {
        // Press Cmd and leave it pressed (app switcher start).
        cmd_hold: cmd_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &kp LGUI>;
        };

        // Release the Cmd that cmd_hold pressed (app switcher end).
        cmd_release: cmd_release {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_release &kp LGUI>;
        };

        // NAV that also holds F19 while the layer is on, so the host can
        // see the layer change (totem-typing keymap overlay).
        nav_sig: nav_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 1 &kp F19>
                , <&macro_pause_for_release>
                , <&macro_release &mo 1 &kp F19>;
            display-name = "NAV+F19";
        };

        // SYM that also holds F20 while the layer is on.
        sym_sig: sym_sig {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo 2 &kp F20>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2 &kp F20>;
            display-name = "SYM+F20";
        };
    };

    combos {
        compatible = "zmk,combos";

        // Q+W pressed together -> Tab (base layer only). Esc stays on SYM+Q.
        // require-prior-idle-ms keeps in-word rolls (Korean ㅂ+ㅈ, vim :wq)
        // typing letters; a combo needs a short pause after the last key.
        combo_tab {
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
            key-positions = <0 1>;
            bindings = <&kp TAB>;
            layers = <0>;
        };

        // K+L pressed together -> Backspace (base layer only).
        // J+K is avoided: IdeaVim maps the jk sequence to Esc.
        // Prior idle keeps rolls such as "walk" or "talk" from deleting.
        combo_bspc {
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
            key-positions = <17 18>;
            bindings = <&kp BACKSPACE>;
            layers = <0>;
        };

        // L+; pressed together -> Enter (base layer only). L is shared with
        // the K+L combo. An Enter that does not go through a layer key.
        // Prior idle keeps rolls such as Java "null;" typing letters.
        combo_enter {
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
            key-positions = <18 19>;
            bindings = <&kp ENTER>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
           &kp Q  &kp W  &kp E     &kp R  &kp T    &kp Y      &kp U            &kp I          &kp O    &kp P
           &kp A  &kp S  &kp D     &kp F  &kp G    &kp H      &kp J            &kp K          &kp L    &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B    &kp N      &kp M            &kp COMMA      &kp DOT  &kp FSLH  &kp APOS
                         &kp LGUI  &sym_sig  &nav_sig    &kp SPACE  &kp RIGHT_SHIFT  &alfred_opt RALT LA(LS(RET))
            >;
        };

        nav_num {
            bindings = <
                   &kp LA(BACKSPACE)   &kp BACKSPACE  &kp UP     &kp DELETE     &kp LA(DELETE)        &kp N5      &kp N6           &kp N7       &kp N8    &kp N9
                   &kp LA(LEFT_ARROW)  &kp LEFT       &kp DOWN   &kp RIGHT      &kp LA(RIGHT)         &kp N0      &kp N1           &kp N2       &kp N3    &kp N4
&kp LG(BACKSPACE)  &kp LG(UP_ARROW)    &kp LG(LEFT)   &kp ENTER  &kp LG(RIGHT)  &kp LG(DOWN_ARROW)    &kp PERIOD  &kp PLUS         &kp MINUS    &kp STAR  &kp FSLH  &kp CARET
                                                      &trans     &trans         &trans                &kp EQUAL   &kp RIGHT_SHIFT  &kp PERCENT
            >;
        };

        sym_func {
            bindings = <
           &kp ESC        &kp LEFT_BRACE        &kp RIGHT_BRACE        &swap_back        &swap_fwd         &kp F1   &kp F2           &kp F3   &kp F4   &kp F5
           &kp TAB        &kp LBKT              &kp RBKT               &kp ENTER         &kp BSLH          &kp F6   &kp F7           &kp F8   &kp F9   &kp F10
&kp GRAVE  &kp LESS_THAN  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &kp UNDERSCORE    &kp F11  &kp F12          &kp F13  &kp F14  &kp F15  &kp F16
                                                &trans                 &trans            &trans            &none    &kp RIGHT_SHIFT  &none
            >;
        };

        // Q = AL Calculator: Karabiner runs ~/bin/safe-eject-external on it.
        device {
            bindings = <
       &kp C_AL_CALCULATOR  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none    &none         &none         &none         &none         &none
&none  &none       &none                 &none                 &none             &none    &none         &none         &none         &none         &none         &bt BT_CLR
                                         &none                 &none             &none    &none         &none         &none
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
